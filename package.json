{
  "name": "niramaya-screening-aid",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src vite.config.js eslint.config.js",
    "format:check": "prettier --check src index.html vite.config.js package.json eslint.config.js README.md docker-compose.yml public/sw.js",
    "format": "prettier --write src index.html vite.config.js package.json eslint.config.js README.md docker-compose.yml public/sw.js",
    "test:oral": "node --test src/oralTriage.test.js",
    "test:ui": "vitest run",
    "test": "npm run test:oral && npm run test:ui"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "vitest": "^3.2.7"
  }
}
